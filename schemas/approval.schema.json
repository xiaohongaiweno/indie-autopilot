{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Approval",
  "description": "Human approval record for a stage transition",
  "type": "object",
  "required": [
    "approval_id",
    "project_id",
    "stage",
    "decision",
    "approved_by",
    "approved_at",
    "artifact_hash",
    "source_event"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^appr-[a-z0-9-]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "stage": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected", "changes_requested"]
    },
    "approved_by": {
      "type": "string",
      "description": "GitHub username of the approver"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_hash": {
      "type": "string",
      "description": "SHA-256 hash of the artifact that was reviewed"
    },
    "comment": {
      "type": "string",
      "maxLength": 2000
    },
    "source_event": {
      "type": "string",
      "description": "GitHub event URL or issue number that triggered this approval"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Approval expires if artifacts change after this time"
    }
  },
  "additionalProperties": false
}
