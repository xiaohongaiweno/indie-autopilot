{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StageResult",
  "description": "Output from a pipeline stage execution",
  "type": "object",
  "required": [
    "project_id",
    "stage",
    "status",
    "generated_at",
    "summary"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "discovery",
        "research",
        "validation",
        "planning",
        "building",
        "testing",
        "release",
        "growth"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed", "skipped"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "mode": {
      "type": "string",
      "enum": ["mock", "live"],
      "description": "Whether this result was generated by mock or live agent"
    },
    "is_real_data": {
      "type": "boolean",
      "description": "False if any data is simulated or placeholder"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_type", "claim", "evidence_type", "confidence"],
        "properties": {
          "source_url": { "type": "string", "format": "uri" },
          "source_type": {
            "type": "string",
            "enum": ["web_search", "api", "document", "observation", "user_input", "simulated", "unavailable"]
          },
          "observed_at": { "type": "string", "format": "date-time" },
          "claim": { "type": "string", "maxLength": 500 },
          "evidence_type": {
            "type": "string",
            "enum": ["fact", "inference", "assumption", "unknown"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "unavailable"]
          },
          "notes": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement"],
        "properties": {
          "statement": { "type": "string" },
          "risk_if_wrong": { "type": "string" },
          "how_to_verify": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "type": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "blocked_by": { "type": "string" }
        }
      }
    },
    "approval_required": {
      "type": "boolean",
      "default": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "code": { "type": "string" },
          "recoverable": { "type": "boolean" }
        }
      }
    }
  },
  "additionalProperties": false
}
